{
  "swagger": "2.0",
  "info": {
    "title": "Masterblog API",
    "description": "A simple RESTful API to list, add, update, delete, search and sort blog posts.",
    "version": "1.0.0"
  },
  "host": "localhost:5002",
  "basePath": "/",
  "schemes": ["http"],
  "tags": [
    { "name": "Post", "description": "Post API - CRUD" }
  ],
  "paths": {
    "/api/posts": {
      "get": {
        "summary": "Returns all posts (optionally sorted)",
        "produces": ["application/json"],
        "tags": ["Post"],
        "parameters": [
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "type": "string",
            "enum": ["title", "content"],
            "description": "Field to sort by"
          },
          {
            "name": "direction",
            "in": "query",
            "required": false,
            "type": "string",
            "enum": ["asc", "desc"],
            "description": "Sort direction (default: asc)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "schema": { "type": "array", "items": { "$ref": "#/definitions/Post" } }
          },
          "400": {
            "description": "Invalid sort field or direction",
            "schema": { "$ref": "#/definitions/Error" }
          }
        }
      },
      "post": {
        "summary": "Creates a new post",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "tags": ["Post"],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/NewPost" }
          }
        ],
        "responses": {
          "201": {
            "description": "Post created",
            "schema": { "$ref": "#/definitions/Post" }
          },
          "400": {
            "description": "Missing title and/or content",
            "schema": { "$ref": "#/definitions/Error" }
          }
        }
      }
    },
    "/api/posts/{id}": {
      "put": {
        "summary": "Updates an existing post",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "tags": ["Post"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "ID of the post to update"
          },
          {
            "name": "body",
            "in": "body",
            "required": false,
            "schema": { "$ref": "#/definitions/UpdatePost" }
          }
        ],
        "responses": {
          "200": {
            "description": "Post updated",
            "schema": { "$ref": "#/definitions/Post" }
          },
          "404": {
            "description": "Post not found",
            "schema": { "$ref": "#/definitions/Error" }
          }
        }
      },
      "delete": {
        "summary": "Deletes a post",
        "produces": ["application/json"],
        "tags": ["Post"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "ID of the post to delete"
          }
        ],
        "responses": {
          "200": {
            "description": "Post deleted",
            "schema": { "$ref": "#/definitions/Message" }
          },
          "404": {
            "description": "Post not found",
            "schema": { "$ref": "#/definitions/Error" }
          }
        }
      }
    },
    "/api/posts/search": {
      "get": {
        "summary": "Searches posts by title and/or content",
        "produces": ["application/json"],
        "tags": ["Post"],
        "parameters": [
          {
            "name": "title",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "Text to search for in the title"
          },
          {
            "name": "content",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "Text to search for in the content"
          }
        ],
        "responses": {
          "200": {
            "description": "List of matching posts (empty if none match)",
            "schema": { "type": "array", "items": { "$ref": "#/definitions/Post" } }
          }
        }
      }
    }
  },
  "definitions": {
    "Post": {
      "type": "object",
      "properties": {
        "id": { "type": "integer", "example": 1 },
        "title": { "type": "string", "example": "First post" },
        "content": { "type": "string", "example": "This is the first post." }
      }
    },
    "NewPost": {
      "type": "object",
      "required": ["title", "content"],
      "properties": {
        "title": { "type": "string", "example": "My new post" },
        "content": { "type": "string", "example": "Hello world!" }
      }
    },
    "UpdatePost": {
      "type": "object",
      "properties": {
        "title": { "type": "string", "example": "Updated title" },
        "content": { "type": "string", "example": "Updated content" }
      }
    },
    "Message": {
      "type": "object",
      "properties": {
        "message": { "type": "string", "example": "Post with id 1 has been deleted successfully." }
      }
    },
    "Error": {
      "type": "object",
      "properties": {
        "error": { "type": "string", "example": "Post with id 99 was not found." }
      }
    }
  }
}